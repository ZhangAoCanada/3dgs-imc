# eps
# ranges_scale
# depth
# random view
# interval

# for noise_method in 1-opacity-detach sigma-detach opacity-sigma-detach

for min_samples in 500
do
    for range_scale in 1
    # for min_samples in 100 300
    do
        nn_start_iter=2000
        nn_derivatives_iter=$((nn_start_iter+500))
        nn_update_interval=500
        # nn_update_interval=1000
        images=images
        init_type=sfm
        noise_lr=5e5
        # cap_max=3000000
        cap_max=2500000
        scale_reg=0.01
        opacity_reg=0.01
        densify_from_iter=500
        densification_interval=400
        # depth_l1_weight_init=0.1
        # depth_l1_weight_init=0.3
        depth_l1_weight_init=0.0
        depth_l1_weight_final=$(echo "scale=10; $depth_l1_weight_init * 0.01" | bc)
        nn_type=allviews
        bound_type=local
        partial_scaling=1e0
        # partial_scaling=1e-2
        sigma_scaling=1e-3
        # eps=0.05
        # eps=3
        eps=5
        # min_samples=300
        # min_samples=500
        minmax=wholeonly
        # range_scale=0.5
        # noise_method=1-opacity-detach
        noise_method=sigma-detach
        # noise_method=opacity-sigma-detach
        random_view_num=1
        dvoxel_size=0.01
        port=12311
        echo "[*****training*****] training with noise_method=${noise_method}"
        CUDA_VISIBLE_DEVICES=1 python train_experimental_branch3.py \
            --source_path /data/zhangao/VastGaussian/Zeche1/train \
            --depths dav2 \
            --test_path /data/zhangao/VastGaussian/Zeche1/test \
            --model_path outputs/mcmc/Zeche1/experimental_branch3_${init_type}_${nn_type}_${bound_type}_${eps}_${min_samples}_${depth_l1_weight_init}_${depth_l1_weight_final}_${minmax}_${range_scale}_${partial_scaling}_${sigma_scaling}_${noise_method}_${random_view_num}_${scale_reg}_${opacity_reg}_${nn_start_iter}_${nn_derivatives_iter}_${nn_update_interval} \
            --images ${images} \
            --resolution -1 \
            --init_type ${init_type} \
            --cap_max ${cap_max} \
            --data_device cpu \
            --scale_reg ${scale_reg} \
            --opacity_reg ${opacity_reg} \
            --noise_lr ${noise_lr} \
            --densify_from_iter ${densify_from_iter} \
            --densification_interval ${densification_interval} \
            --depth_l1_weight_init ${depth_l1_weight_init} \
            --depth_l1_weight_final ${depth_l1_weight_final} \
            --nn_type ${nn_type} \
            --bound_type ${bound_type} \
            --partial_scaling ${partial_scaling} \
            --sigma_scaling ${sigma_scaling} \
            --eps ${eps} \
            --min_samples ${min_samples} \
            --range_scale ${range_scale} \
            --minmax ${minmax} \
            --noise_method ${noise_method} \
            --random_view_num ${random_view_num} \
            --nn_start_iter ${nn_start_iter} \
            --nn_derivatives_iter ${nn_derivatives_iter} \
            --nn_update_interval ${nn_update_interval} \
            --antialiasing \
            --dvoxel_size ${dvoxel_size} \
            --port $port 
    done
done

